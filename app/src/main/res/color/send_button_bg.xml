<?xml version="1.0" encoding="utf-8"?>
<!-- backgroundTint for the round send button.
     Enabled  → primary color at 85% alpha (one shade lighter than colorPrimary)
     Disabled → primary color at 30% alpha (two shades lighter, for empty input) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false"
        android:color="?attr/colorPrimary"
        android:alpha="0.30" />
    <item
        android:color="?attr/colorPrimary"
        android:alpha="0.85" />
</selector>
