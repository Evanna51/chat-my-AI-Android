<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_home_surface">

    <!-- Title bar: WiChat + search + settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_hint"
            app:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_action_menu"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Inline glass search bar (hidden until 🔍 tapped) -->
    <com.example.aichat.LiquidGlassView
        android:id="@+id/glassToolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:glassCornerRadius="16dp"
        app:glassBlurRadius="25dp"
        app:glassEdgeHighlight="true"
        app:glassDynamicResponse="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                app:tint="@color/ios_section_label" />

            <EditText
                android:id="@+id/searchEdit"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:hint="@string/search_hint"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:background="@android:color/transparent"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="@color/ios_section_label" />
        </LinearLayout>
    </com.example.aichat.LiquidGlassView>

    <!-- Tab pills: 最近 / 置顶 / 小说 / 全部 (with sliding indicator) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="14dp"
        android:padding="6dp"
        android:background="@drawable/bg_home_tab_container"
        android:elevation="3dp"
        android:clipToOutline="true">

        <View
            android:id="@+id/tabIndicator"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_home_tab_indicator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabRecent"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/home_tab_recent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/home_tab_text"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabPinned"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/home_tab_pinned"
                android:textSize="14sp"
                android:textColor="@color/home_tab_text"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabNovel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/home_tab_novel"
                android:textSize="14sp"
                android:textColor="@color/home_tab_text"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/home_tab_all"
                android:textSize="14sp"
                android:textColor="@color/home_tab_text"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>

    <!-- Session list (cards) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sessionList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/home_no_sessions"
        android:textColor="@color/ios_section_label"
        android:textSize="14sp" />

    <!-- Assistant section header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/my_assistants"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/list_title_color" />

        <TextView
            android:id="@+id/btnViewAllAssistants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_all_assistants"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Assistant strip (each item is its own glass card) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHomeAssistants"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:layout_marginBottom="6dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none" />

    <!-- Bottom: new chat button (no separate surface, flush with page bg) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewChat"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"
        android:text="@string/new_chat"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="22dp"
        app:cornerRadius="26dp"
        android:textSize="16sp" />

</LinearLayout>
