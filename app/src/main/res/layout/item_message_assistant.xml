<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/textTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        android:letterSpacing="0.01"
        android:textColor="@color/chat_meta_text_color" />

    <!-- Thinking 区域：头部和内容气泡样式在这里调 -->
    <LinearLayout
        android:id="@+id/layoutReasoning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="4dp"
        android:visibility="gone">
        <!-- Thinking 标题行（可点击折叠/展开） -->
        <TextView
            android:id="@+id/textReasoningHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thinking"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/chat_meta_text_color"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
        <!-- Thinking 内容：默认折叠时显示两行，展开显示全文 -->
        <TextView
            android:id="@+id/textReasoningContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:layout_marginTop="2dp"
            android:padding="10dp"
            android:textSize="13sp"
            android:textColor="@color/chat_reasoning_text_color"
            android:background="@drawable/bubble_reasoning"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 助手消息气泡容器 -->
    <FrameLayout
        android:id="@+id/layoutAssistantBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_assistant_wa"
        android:clipChildren="false"
        android:clipToPadding="false">
        <!-- 正文内容：长文折叠/展开逻辑由 MessageAdapter 控制 -->
        <TextView
            android:id="@+id/textContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/chat_assistant_text_color"
            android:textSize="16sp"
            android:textIsSelectable="true" />
        <!-- 浮动消息折叠按钮：玻璃风胶囊，icon + 文案 [收起/展开]。
             由 MessageAdapter.applyCollapseToggleAffix 在滚动时把 translationY 调整为
             气泡可见区域中点，随消息滚动保持可见。 -->
        <LinearLayout
            android:id="@+id/textCollapseToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_collapse_toggle"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">
            <ImageView
                android:id="@+id/textCollapseIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_collapse_expand_less"
                android:tint="@color/action_button_icon_tint"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/textCollapseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/action_button_icon_tint"
                android:text="@string/collapse_message" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/textUsage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="12sp"
        android:textColor="@color/chat_meta_text_color"
        android:visibility="gone" />

    <!-- 助手消息底部操作区：单层折叠 + 单条工具栏。
         顺序: [折叠按钮] 删除 / 复制 / 编辑 / 打开 / 大纲(writer) / 语音(character) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Toggle: collapsed → ic_chevron_right (>), expanded → ic_action_expand_left (<).
             No background; sits flush with the row. -->
        <ImageButton
            android:id="@+id/actionExpand"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/action_button_icon_tint"
            android:contentDescription="展开操作" />

        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/actionDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="@drawable/bg_action_button"
                android:scaleType="centerInside"
                android:src="@drawable/ic_action_delete"
                android:tint="@color/action_button_icon_tint"
                android:contentDescription="删除" />

            <ImageButton
                android:id="@+id/actionCopy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:padding="6dp"
                android:background="@drawable/bg_action_button"
                android:scaleType="centerInside"
                android:src="@drawable/ic_action_copy"
                android:tint="@color/action_button_icon_tint"
                android:contentDescription="复制" />

            <ImageButton
                android:id="@+id/actionEdit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:padding="6dp"
                android:background="@drawable/bg_action_button"
                android:scaleType="centerInside"
                android:src="@drawable/ic_action_edit"
                android:tint="@color/action_button_icon_tint"
                android:contentDescription="编辑" />

            <ImageButton
                android:id="@+id/actionOpen"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:padding="6dp"
                android:background="@drawable/bg_action_button"
                android:scaleType="centerInside"
                android:src="@drawable/ic_action_open"
                android:tint="@color/action_button_icon_tint"
                android:contentDescription="打开" />

            <!-- 大纲：仅写作模式显示，主题色 -->
            <ImageButton
                android:id="@+id/actionOutline"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:padding="6dp"
                android:background="@drawable/bg_action_button"
                android:scaleType="centerInside"
                android:src="@drawable/ic_action_outline"
                android:tint="?attr/colorPrimary"
                android:contentDescription="提取到大纲"
                android:visibility="gone" />

            <!-- 语音：仅角色模式显示，主题色 -->
            <ImageButton
                android:id="@+id/actionVoicePlay"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:padding="6dp"
                android:background="@drawable/bg_action_button"
                android:scaleType="centerInside"
                android:src="@drawable/ic_action_voice_play"
                android:tint="?attr/colorPrimary"
                android:contentDescription="朗读" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
