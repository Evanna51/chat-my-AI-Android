<?xml version="1.0" encoding="utf-8"?>
<!-- TTS 字段选择器：玻璃卡片 + 圆角 + 顶部高光 + 底部 tip。
     标题 / 选项列表 / 底部 tip 由 TTSSettingsActivity 动态填入。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ios_separator"
        android:alpha="0.6" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp">

        <LinearLayout
            android:id="@+id/containerPickerItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/dividerPickerTip"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ios_separator"
        android:alpha="0.6"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textPickerTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:textSize="12sp"
        android:textColor="@color/ios_section_label"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />
</LinearLayout>
