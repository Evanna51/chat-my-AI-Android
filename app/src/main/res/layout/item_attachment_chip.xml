<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_attachment_chip"
    android:paddingStart="10dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_marginEnd="8dp">

    <ImageView
        android:id="@+id/iconAttachment"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_file_doc"
        app:tint="?attr/colorOnSurface"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/textAttachmentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurface"
        android:singleLine="true"
        android:ellipsize="middle"
        android:maxWidth="160dp" />

    <ImageButton
        android:id="@+id/btnAttachmentRemove"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close_small"
        app:tint="@color/ios_section_label"
        android:contentDescription="@string/attachment_remove" />
</LinearLayout>
