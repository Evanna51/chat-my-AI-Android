<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/textTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        android:letterSpacing="0.01"
        android:textColor="@color/chat_meta_text_color" />

    <!-- User message bubble.
         Long-pressing the bubble opens a floating action toolbar
         (MessageActionPopup) with copy / edit / regenerate / outline / delete.
         No persistent action row underneath — keeps the chat surface clean. -->
    <TextView
        android:id="@+id/textContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:padding="12dp"
        android:background="@drawable/bubble_user_wa"
        android:textColor="@color/chat_user_text_color"
        android:textSize="16sp"
        android:textIsSelectable="true" />
</LinearLayout>
