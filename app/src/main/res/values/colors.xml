<?xml version="1.0" encoding="utf-8"?>
<!--
  主题色取自 iOS 18 systemColors（Apple HIG）— 比之前的 Material 700 系列更轻盈、更现代。
  各色配 4 档：primary / subtle（极浅 hint 背景）/ light（mid-tone bg，用于胶囊/标签）/ deep（强调态）。
  夜间版在 values-night/colors.xml 同步重写。
-->
<resources>
    <color name="primary">#007AFF</color>
    <!-- iOS systemBlue -->
    <color name="primary_blue">#007AFF</color>
    <color name="primary_blue_subtle">#F2F8FF</color>
    <color name="primary_blue_light">#D6EBFF</color>
    <color name="primary_blue_deep">#0040A0</color>
    <!-- iOS systemGreen -->
    <color name="primary_green">#34C759</color>
    <color name="primary_green_subtle">#F4FCF6</color>
    <color name="primary_green_light">#D5F5DD</color>
    <color name="primary_green_deep">#1F8A35</color>
    <!-- iOS systemPurple -->
    <color name="primary_purple">#AF52DE</color>
    <color name="primary_purple_subtle">#FAF4FD</color>
    <color name="primary_purple_light">#EFD9F8</color>
    <color name="primary_purple_deep">#7B2D9C</color>
    <!-- iOS systemOrange -->
