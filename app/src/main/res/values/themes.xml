<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIChat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">?attr/colorPrimaryLight</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorPrimarySubtle">@color/primary_blue_subtle</item>
        <item name="colorPrimaryLight">@color/primary_blue_light</item>
        <item name="colorPrimaryDeep">@color/primary_blue_deep</item>
        <!-- 中性化 secondary container：M3 默认是淡紫色（baseline scheme），这里改成 iOS cell 白
             （亮色 = #FFFFFF / 暗色 = #2C2C2E），让 TonalButton、Filter Chip 选中态等默认走中性。 -->
        <item name="colorSecondaryContainer">@color/ios_cell_bg</item>
        <item name="colorOnSecondaryContainer">?attr/colorPrimary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AIChat.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AIChat.MaterialAlertDialog</item>
        <!-- Unified controls: switches + radio buttons follow theme color. -->
        <item name="materialSwitchStyle">@style/Widget.AIChat.Switch</item>
        <item name="radioButtonStyle">@style/Widget.AIChat.RadioButton</item>
        <!-- 全局统一输入框：所有 TextInputLayout / GlassTextInputLayout 默认拿到玻璃风外观 -->
        <item name="textInputStyle">@style/Widget.AIChat.GlassInput</item>
    </style>

    <style name="Theme.AIChat.Blue" parent="Theme.AIChat">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimarySubtle">@color/primary_blue_subtle</item>
        <item name="colorPrimaryLight">@color/primary_blue_light</item>
        <item name="colorPrimaryDeep">@color/primary_blue_deep</item>
    </style>

    <style name="Theme.AIChat.Green" parent="Theme.AIChat">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimarySubtle">@color/primary_green_subtle</item>
        <item name="colorPrimaryLight">@color/primary_green_light</item>
        <item name="colorPrimaryDeep">@color/primary_green_deep</item>
    </style>

    <style name="Theme.AIChat.Purple" parent="Theme.AIChat">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorPrimarySubtle">@color/primary_purple_subtle</item>
        <item name="colorPrimaryLight">@color/primary_purple_light</item>
        <item name="colorPrimaryDeep">@color/primary_purple_deep</item>
    </style>

    <style name="Theme.AIChat.Orange" parent="Theme.AIChat">
        <item name="colorPrimary">@color/primary_orange</item>
        <item name="colorPrimarySubtle">@color/primary_orange_subtle</item>
        <item name="colorPrimaryLight">@color/primary_orange_light</item>
        <item name="colorPrimaryDeep">@color/primary_orange_deep</item>
    </style>

    <style name="TextAppearance.AIChat.Toolbar.Title.Small" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.AIChat.Toolbar.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.AIChat.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- Theme-tinted MaterialSwitch: track + thumb follow colorPrimary when on. -->
    <style name="Widget.AIChat.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/aichat_switch_track</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
        <item name="thumbTint">@color/aichat_switch_thumb</item>
        <item name="thumbIconTint">@android:color/transparent</item>
    </style>

    <!-- Theme-tinted RadioButton: ring + dot follow colorPrimary when checked. -->
    <style name="Widget.AIChat.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/aichat_radio_tint</item>
    </style>

    <!-- Liquid-glass input: rim highlight + soft bottom shadow drawn by
         GlassTextInputLayout; theme colorPrimary feeds focused stroke。
         空闲态 stroke 走 colorPrimaryLight，营造「淡淡的主题色边框」。 -->
    <style name="Widget.AIChat.GlassInput" parent="Widget.AIChat.TextInputLayout">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/glass_input_fill</item>
        <item name="boxStrokeColor">@color/glass_input_stroke</item>
        <item name="hintTextColor">@color/glass_input_hint</item>
        <item name="android:textColorHint">@color/glass_input_hint_idle</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCollapsedPaddingTop">8dp</item>
        <item name="errorIconDrawable">@null</item>
        <!-- 通过主题 overlay 让内嵌 EditText 用更紧凑的 padding -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.AIChat.TextInputEditText</item>
    </style>

    <style name="ThemeOverlay.AIChat.TextInputEditText" parent="">
        <item name="editTextStyle">@style/Widget.AIChat.TextInputEditText</item>
    </style>

    <!-- 标题在顶上的变体（OutlinedBox + 浮动 hint）。
         继承 GlassInput 的颜色 / 边框 / padding，由 LabeledGlassTextInputLayout
         负责把顶部高光让开 label 切口。 -->
    <style name="Widget.AIChat.LabeledGlassInput" parent="Widget.AIChat.GlassInput">
        <item name="hintEnabled">true</item>
        <item name="hintAnimationEnabled">true</item>
        <item name="boxCollapsedPaddingTop">10dp</item>
    </style>

    <!-- 比 Material 默认 OutlinedBox 紧一些；上下各 12dp。 -->
    <style name="Widget.AIChat.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- iOS 2026 公共 styles -->
    <style name="Widget.AIChat" parent="" />

    <!-- 章节计划对话框里每个字段上方的小标签（13sp，灰色，紧凑）。 -->
    <style name="Widget.AIChat.PlanFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ios_section_label</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Widget.AIChat.IOSSectionHeader">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ios_section_label</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.AIChat.IOSListRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.AIChat.GlassCard">
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/glass_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
    </style>

    <style name="ThemeOverlay.AIChat.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/bg_material_alert_dialog</item>
        <item name="colorSurface">@color/dialog_surface_bg</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AIChat.Dialog</item>
    </style>

    <style name="ShapeAppearance.AIChat.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
