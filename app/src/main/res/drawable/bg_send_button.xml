<?xml version="1.0" encoding="utf-8"?>
<!-- Pill / large-rounded-rectangle background for the send button.
     Color is set via android:backgroundTint (@color/send_button_bg) so the
     same shape can shift between enabled / disabled tints. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@android:color/white" />
</shape>
